# Google Sheets — required for waitlist storage
# 1. Create a Google Cloud project and enable Google Sheets API
# 2. Create a service account and download the JSON key
# 3. Create a Google Sheet named "Waitlist" (or set GOOGLE_SHEET_NAME)
# 4. Share the sheet with the service account email (Editor access)
# 5. Copy the Sheet ID from the URL: docs.google.com/spreadsheets/d/SHEET_ID/edit

GOOGLE_SHEET_ID=your_spreadsheet_id_here
GOOGLE_SHEET_NAME=Waitlist
# Optional: remote relay pairing storage reuses the same spreadsheet and creates
# this tab automatically when Upstash Redis is not configured.
GOOGLE_REMOTE_PAIRINGS_SHEET_NAME=RemotePairings
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"...","universe_domain":"googleapis.com"}

# Separate dashboard deployment. Leave blank only when developing the two apps
# behind a shared local reverse proxy.
VITE_MEMCODE_DASHBOARD_URL=https://your-dashboard.example.com
